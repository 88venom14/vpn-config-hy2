# Shell scripts must keep LF, otherwise bash fails on Linux.
*.sh text eol=lf

# Config is served as a raw file to Linux servers.
*.yaml text eol=lf
*.yml text eol=lf

*.md text eol=crlf

# Web assets are served as-is by GitHub Pages; keep LF everywhere.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf